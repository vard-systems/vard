# Build output
/bin/
*.test
*.out
coverage.*
*.prof

# Go workspace
go.work
go.work.sum

# Secrets: every .env except the examples
.env
.env.*
!.env.example
*.pem
*.key

# Logs (scripts/start.sh writes .logs/)
/.logs/
*.log

# Claude Code: the project's own settings and commands are committed; a
# personal override of them is not.
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store

# The production Caddyfile is the server's: it is put in deploy/ there, beside
# compose.yaml, which mounts it. Caddyfile.local stays, for make deploy-local.
/deploy/Caddyfile
