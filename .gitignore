# Build output
/bin/
*.test
*.out
coverage.*
*.prof

# Go workspace
go.work
go.work.sum

# Secrets: every .env except the examples
.env
.env.*
!.env.example
*.pem
*.key

# Logs (scripts/start.sh writes .logs/)
/.logs/
*.log

# Claude Code: the project's own settings and commands are committed; a
# personal override of them is not.
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store


# Made on the server from what is committed: the proxy's configuration
# (make nginx-config) and the database's dumps (make db-backup).
/deploy/nginx/vard.conf
/deploy/backups/
