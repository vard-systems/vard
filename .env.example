# The public listener: the OAuth 2.0 / OpenID Connect provider and the account
# API the id app calls. Only the id app's server reaches it.
VARD_ADDR=:8080

# The admin listener: the admin API, which only the console's server reaches.
# Never publish this port.
VARD_ADMIN_ADDR=:8081

# The provider's public URL: the iss of every token, and the base of every URL
# in /.well-known/openid-configuration. It is the id app's origin, whose server
# passes the provider paths on to the public listener. `make dev` sets it to
# http://localhost:5173.
VARD_ISSUER=http://localhost:5173

# Where the id app is served. Leave it unset to use the issuer, which is the
# recommended setup: one origin for the provider and the users' app.
# VARD_ACCOUNT_URL=

# Where the console is served. Only its origin may change anything through the
# admin API. `make dev` sets it to http://localhost:5174.
VARD_ADMIN_URL=http://localhost:5174

# Session cookies are Secure when the URLs above are https, which is what a
# deployment wants; set this only to override that.
# VARD_SECURE_COOKIES=

# Extra browser origins allowed to call the cookie-authenticated APIs from
# script. With each app on the same origin as its API, none is needed: every
# origin listed here can act as whoever is signed in.
VARD_CORS_ORIGINS=

# Addresses or CIDR ranges of the reverse proxies in front of the API, comma
# separated, whose X-Forwarded-For header is trusted. Empty trusts none. Behind
# a proxy this has to be set, or every request looks like the proxy's — to the
# activity log, and to the rate limit. The apps' servers are such a proxy:
# under `make dev` they run on this machine.
VARD_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Attempts per minute one address may make at the endpoints that take a
# password or send an email. 0 turns the limit off.
VARD_RATE_LIMIT=20

# The least severe log line written: debug, info, warn or error. Every line
# carries service=<the project slug>, to tell this server apart in shared logs.
VARD_LOG_LEVEL=info

# What a fresh installation starts with for administrators' two-factor
# sign-in: optional (each administrator turns one on for themselves, from
# their profile) or required (every one of them sets up an authenticator app
# at their next sign-in).
#
# It is read once, on the first start, and written to the database. After that
# the setting is the panel's — Administrators · Two-factor sign-in — and
# changing this line does nothing. Unset, it is optional.
VARD_ADMIN_MFA=optional

# Days a token signing key signs before the next one takes over. 0 never
# rotates on its own.
VARD_KEY_ROTATION_DAYS=90

# Days the activity log keeps an entry. Expired sessions, codes and tokens are
# swept every hour; without a limit the log would be the one table that grew
# with every sign-in forever. 0 keeps every entry.
VARD_AUDIT_RETENTION_DAYS=365

# Encrypts the private keys tokens are signed with, and every secret kept in
# the database. At least 32 characters; make one with `openssl rand -base64
# 32`. `make setup` writes one for you. Changing it alone makes the stored
# keys unreadable, which signs everyone out: rotate it instead.
VARD_SECRET_KEY=

# New passwords are checked against the ones known from breaches, through the
# Pwned Passwords range API, when this names it: only the first five hex
# characters of a password's SHA-1 are sent. An API that does not answer in
# two seconds lets the password through. Empty checks nothing.
#   VARD_PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com
VARD_PWNED_PASSWORDS_URL=

# To rotate VARD_SECRET_KEY: put the old one here, a new one above, restart,
# run `vard secrets reseal`, then empty this. Until then the old key opens
# what it sealed, and seals nothing.
VARD_SECRET_KEY_PREVIOUS=

# The mail server, read on the first start only: from then on it is the Mail
# page's, in the panel. With no host, sending starts switched off and every
# email is written to the server's log instead, which is enough while
# developing. The port decides the encryption it starts with — 465 is TLS from
# the first byte, anything else STARTTLS — and the Mail page changes it.
VARD_SMTP_HOST=
VARD_SMTP_PORT=587
VARD_SMTP_USERNAME=
VARD_SMTP_PASSWORD=
VARD_SMTP_FROM=Vard <no-reply@localhost>

VARD_DB_DSN=postgres://postgres:postgres@localhost:5432/vard?sslmode=disable
# The schema owner's DSN, used only to migrate. Set, the server runs as
# VARD_DB_DSN's user, makes that role if it is missing, and grants it the rows
# of every table and nothing else. Empty migrates as VARD_DB_DSN's user, as
# development does.
VARD_DB_MIGRATE_DSN=
VARD_DB_DRIVER=postgres
# How the server's connection formats times; every column is timestamptz, so
# this changes no value stored.
VARD_DB_TIMEZONE=UTC
VARD_DB_LOG_QUERIES=false
VARD_DB_MIGRATE=true
# Connections one server process may hold to the database. Every process
# together has to stay under Postgres's own max_connections (100 by default):
# with three API processes, 25 each leaves room for the migration tool and a
# psql session.
VARD_DB_MAX_CONNS=25
# Postgres ends a query that runs longer, and a transaction left idle longer,
# instead of letting either hold its locks; 0 is no limit.
VARD_DB_STATEMENT_TIMEOUT=15s
VARD_DB_IDLE_IN_TRANSACTION_TIMEOUT=60s

# Redis, as two databases. The cache database holds what every page reads —
# the languages and their text, the organisation, the login flows, the sign-in
# buttons. The session database holds who is signed in and what they may do —
# the sessions, the administrators with their roles, the applications by client
# id — and the rate limit's counts, so every server process shares one limit.
# Leave VARD_REDIS_HOST empty to run without it: every read then goes to
# the database and each process counts on its own. A host that is set but
# does not answer stops the server at startup.
VARD_REDIS_HOST=localhost
VARD_REDIS_PORT=6379
# For a Redis with ACLs or requirepass; empty for a local one.
VARD_REDIS_USERNAME=
VARD_REDIS_PASSWORD=
# The two database numbers, 0-15 on a default server. They have to differ:
# flushing the cache never signs anybody out.
VARD_REDIS_CACHE_DB=0
VARD_REDIS_SESSION_DB=1
# Every key starts with this, so one Redis can serve several installations.
VARD_REDIS_PREFIX=vard:
