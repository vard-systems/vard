{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go doc:*)",
      "Bash(gofmt:*)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make web-check)",
      "Bash(make web-test)",
      "Bash(make web)",
      "Bash(make build)",
      "Bash(make migrate-status)",
      "Bash(make docs)",
      "Bash(make docs-check)",
      "Bash(bun run check)",
      "Bash(bun run lint)",
      "Bash(bun run test:*)",
      "Bash(bunx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./web/console/.env)",
      "Read(./web/id/.env)",
      "Read(./deploy/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}
