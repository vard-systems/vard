{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		// The kit is drawn inside a SvelteKit app; its declarations name
		// $app/forms, which the dialog posts with.
		"types": ["@sveltejs/kit"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "*.config.js"]
}
