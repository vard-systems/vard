# Settings for deploy/compose.yaml. Copy to deploy/.env and fill in.

# The users' site, as the browser reaches it: the id app, the OAuth/OIDC
# provider, the issuer of every token. The id app's port 8080.
PUBLIC_URL=http://localhost:8080

# The staff site, as the browser reaches it: the console. Its port 8081,
# published on the server's loopback only. Session cookies are Secure when
# these are https.
ADMIN_URL=http://localhost:8081

# openssl rand -base64 32 — keep it forever: it unlocks the token signing keys.
VARD_SECRET_KEY=

# openssl rand -hex 32 — hex, not base64: the password goes into a postgres://
# URL, and a "/" or "+" in it makes that URL unparseable.
POSTGRES_PASSWORD=

# openssl rand -hex 32. Redis holds the sessions, so anything on the compose
# network that could reach it without one could sign itself in.
REDIS_PASSWORD=

# A second factor for every administrator: required, or optional. Compose
# defaults this to required; the server's own default is optional, so that a
# fresh installation can be got into at all. After the first start the setting
# lives in the database, where a super admin owns it.
VARD_ADMIN_MFA=required

# How many attempts per minute one address may make at the endpoints that take
# a password or send an email. Zero turns the limit off. Shared across API
# processes through Redis.
VARD_RATE_LIMIT=20

# The least severe log line written: debug, info, warn or error. Every line
# carries service=<the project slug>, to tell this server apart in shared logs.
VARD_LOG_LEVEL=info

# Password reset emails. Without a host they are only written to the log.
VARD_SMTP_HOST=
VARD_SMTP_PORT=587
VARD_SMTP_USERNAME=
VARD_SMTP_PASSWORD=
VARD_SMTP_FROM=My Website <no-reply@mywebsite.com>

# What the API reports as its version, baked into the image at build time.
# `make docker-up` sets it from git; set it here to pin one.
#VERSION=dev
