# nginx in front of Vard: TLS, HSTS, and the two sites passed on to the apps
# that deploy/compose.yaml publishes on this machine's loopback.
#
# Made into deploy/nginx/vard.conf by `make nginx-config`, which fills in the
# addresses from deploy/.env. Install it, once the certificate exists (see
# deploy/README.md):
#
#   sudo cp deploy/nginx/vard.conf /etc/nginx/conf.d/vard.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Everything is set inside these server blocks, so another site this nginx
# serves is not changed; only the upstreams and the rate-limit zone are
# shared, and are named for Vard.

upstream vard_id {
	server {{ID_UPSTREAM}};
	keepalive 32;
}

upstream vard_console {
	server {{CONSOLE_UPSTREAM}};
	keepalive 16;
}

# A generous ceiling per address, for floods; the API keeps its own, tighter
# limit on what takes a password or sends mail.
limit_req_zone $binary_remote_addr zone=vard_per_address:10m rate=20r/s;

# Plain http answers only the certificate authority's challenge, and sends
# everything else to https.
server {
	listen 80;
	listen [::]:80;
	server_name {{ID_HOST}} {{CONSOLE_HOST}}{{MTLS_SERVER_NAME}};
	server_tokens off;

	location /.well-known/acme-challenge/ {
		root /var/www/certbot;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

# The sign-in pages, the provider and the account API: the users' site.
# `listen … http2` rather than `http2 on`, which nginx before 1.25 (Ubuntu
# 24.04's 1.24 among them) does not know; a newer one only warns.
server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name {{ID_HOST}};
	server_tokens off;

	ssl_certificate /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
	# Mozilla's intermediate profile: TLS 1.2 and 1.3, forward secrecy only.
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_session_timeout 1d;
	ssl_session_cache shared:vard_tls:10m;
	ssl_session_tickets off;

	# Browsers come back over https only, for two years. The apps send every
	# other security header themselves (src/lib/server/headers.ts).
	add_header Strict-Transport-Security "max-age=63072000" always;

	# The API's own limit on a body (a SAML response, a form post).
	client_max_body_size 1m;

	location / {
		limit_req zone=vard_per_address burst=60 nodelay;
		limit_req_status 429;

		proxy_pass http://vard_id;
		include /etc/nginx/vard-proxy.conf;
		# The app's own address, not whatever Host a client sent.
		proxy_set_header Host {{ID_HOST}};
		# A client certificate is only ever the mutual TLS host's to pass
		# on; one a client wrote itself is dropped here.
		proxy_set_header X-Client-Certificate "";
	}
}

# {{MTLS_BEGIN}}
# Mutual TLS (RFC 8705): the provider's endpoints a client calls with its
# certificate, on a host of their own so that no browser on the sign-in
# pages is ever asked to pick one. Only those endpoints are passed on.
server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name {{MTLS_HOST}};
	server_tokens off;

	ssl_certificate /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_session_timeout 1d;
	ssl_session_cache shared:vard_mtls:10m;
	ssl_session_tickets off;

	# Ask for a certificate, and leave judging it to the API: a self-signed
	# one is matched against the application's registered certificate, a
	# CA-issued one against VARD_MTLS_CA_FILE. The handshake has already
	# proved the client holds its key.
	ssl_verify_client optional_no_ca;

	add_header Strict-Transport-Security "max-age=63072000" always;
	client_max_body_size 1m;

	location ~ ^/oauth2/(token|par|revoke|introspect|userinfo|device_authorization)$ {
		limit_req zone=vard_per_address burst=60 nodelay;
		limit_req_status 429;

		proxy_pass http://vard_id;
		include /etc/nginx/vard-proxy.conf;
		proxy_set_header Host {{ID_HOST}};
		# The certificate this connection was made with, URL-encoded PEM, or
		# none: an empty value is not sent, so a client's own is dropped.
		proxy_set_header X-Client-Certificate $ssl_client_escaped_cert;
	}

	location / {
		return 404;
	}
}
# {{MTLS_END}}

# The panel and the admin API: the staff site.
server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name {{CONSOLE_HOST}};
	server_tokens off;

	ssl_certificate /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_session_timeout 1d;
	ssl_session_cache shared:vard_tls:10m;
	ssl_session_tickets off;

	add_header Strict-Transport-Security "max-age=63072000" always;

	# A logo upload, base64 in JSON, is the largest body the panel sends.
	client_max_body_size 1m;

	# Only the staff need the panel. To let in only their addresses, list
	# them here; everyone else is refused before the panel is reached.
	#   allow 203.0.113.10;
	#   allow 198.51.100.0/24;
	#   deny all;

	location / {
		limit_req zone=vard_per_address burst=60 nodelay;
		limit_req_status 429;

		proxy_pass http://vard_console;
		include /etc/nginx/vard-proxy.conf;
		proxy_set_header Host {{CONSOLE_HOST}};
		# Nothing on this site reads a client certificate; one a client
		# wrote itself is dropped all the same.
		proxy_set_header X-Client-Certificate "";
	}
}
